// Prisma schema for the Merchant Installment Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum SaleStatus {
  PENDING
  ACTIVE
  ELIGIBLE
  COLLECTED
  COMPLETED
  CANCELLED
  DEFAULTED
}

enum CollectionStatus {
  NOT_ELIGIBLE
  ELIGIBLE
  COLLECTED
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  CARD
  OTHER
}

enum UserRole {
  MERCHANT
  CUSTOMER
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  passwordHash String
  firstName    String
  lastName     String
  phoneNumber  String?   @unique
  role         UserRole  @default(CUSTOMER)
  isActive     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  merchant     Merchant?
  customer     Customer?

  @@index([email])
}

model Merchant {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  customers Customer[]
  sales     Sale[]
}

model Product {
  id             String        @id @default(cuid())
  merchantId     String
  merchant       Merchant      @relation(fields: [merchantId], references: [id])
  name           String
  description    String?
  price          Int
  stockQuantity  Int           @default(0)
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sales          Sale[]

  @@index([merchantId])
}

model Customer {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  name       String
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sales      Sale[]

  @@index([merchantId])
}

model Sale {
  id                      String            @id @default(cuid())
  merchantId              String
  merchant                Merchant          @relation(fields: [merchantId], references: [id])
  productId               String
  product                 Product           @relation(fields: [productId], references: [id])
  customerId              String
  customer                Customer          @relation(fields: [customerId], references: [id])
  sellingPrice            Int
  minimumCollectionAmount Int
  paymentDurationDays     Int?
  expectedInstallments    Int?
  status                  SaleStatus        @default(PENDING)
  collectionStatus        CollectionStatus  @default(NOT_ELIGIBLE)
  totalPaid               Int               @default(0)
  balance                 Int
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  payments                Payment[]
  paymentPlan             PaymentPlan?

  @@index([merchantId])
  @@index([customerId])
  @@index([productId])
}

model PaymentPlan {
  id                      String   @id @default(cuid())
  saleId                  String   @unique
  sale                    Sale     @relation(fields: [saleId], references: [id])
  totalPrice              Int
  minimumCollectionAmount Int
  paymentDurationDays     Int?
  expectedInstallments    Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Payment {
  id              String        @id @default(cuid())
  saleId          String
  sale            Sale          @relation(fields: [saleId], references: [id])
  amount          Int
  paymentDate     DateTime      @default(now())
  paymentMethod   PaymentMethod @default(CASH)
  recordedBy      String?
  receiptNumber   String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([saleId])
}
